# ============================================================
# WebTemplate — .env configuration template
# Copy to project root: cp config_examples/.env_example .env
# Permissions are auto-enforced to 600 on startup.
# ============================================================

# ----------------------------------------------------------
# REQUIRED — app will not start without this
# ----------------------------------------------------------
# Random secret used to sign session cookies.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
UI_SECRET_KEY=replace_with_a_strong_random_secret

# ----------------------------------------------------------
# SIGNAL BOT (optional)
# ----------------------------------------------------------
# Set to true to enable the Signal bot background worker
SIGNAL_BOT=false

# Workflow strategy for Signal attachments:
#   COPY — copy file to inbox only (default)
#   FULL — full processing: archive + Excel update
SIGNAL_WORKFLOW_STRATEGY=COPY

# ----------------------------------------------------------
# EMAIL / 2FA (required only if any user has use_2fa=1 with email)
# ----------------------------------------------------------
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=your_bot@gmail.com
EMAIL_PASSWORD=your_app_password_here

# ----------------------------------------------------------
# NETWORK STORAGE / SMB (required only if using SMBFileClient)
# ----------------------------------------------------------
NET_SERVER_IP=192.168.0.53
NET_USERNAME=share_user
NET_PASSWORD=share_password

# ----------------------------------------------------------
# HTTPS / TLS (optional — leave empty to use plain HTTP)
# ----------------------------------------------------------
# Paths to PEM-format certificate and key files.
# Generate self-signed: openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem -days 365 -nodes
UI_SSL_KEYFILE=
UI_SSL_CERTFILE=

# ----------------------------------------------------------
# DOCUMENT STORAGE (Windows only — on macOS/Linux paths are set in config.py)
# ----------------------------------------------------------
# DOC_DIR=C:/tmp/webtemplate/dd
